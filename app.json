{
  "expo": {
    "name": "CarMinder",
    "slug": "CarMinder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carminder",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.carminder.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSBluetoothAlwaysUsageDescription": "CarMinder uses Bluetooth to connect to your OBD-II adapter and read vehicle diagnostics.",
        "NSBluetoothPeripheralUsageDescription": "CarMinder uses Bluetooth to connect to your OBD-II adapter and read vehicle diagnostics.",
        "NSCameraUsageDescription": "CarMinder uses the camera to scan receipt details for maintenance events.",
        "NSPhotoLibraryUsageDescription": "CarMinder can access photos if you choose a receipt image from your library.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.85293564173-s45cv8b32c8d394nhdfpqr1sb9ebigf2"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.carminder.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "react-native-ble-plx",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "CarMinder uses the camera to scan receipt details for maintenance events.",
          "photosPermission": "CarMinder can access photos if you choose a receipt image from your library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "acf90c67-6607-4433-b3a7-990766cdf1e9"
      }
    }
  }
}
