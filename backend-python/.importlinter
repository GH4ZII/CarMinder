[importlinter]
root_packages =
    routers
    services
    repositories
    domain
    schemas
    config
include_external_packages = True

[importlinter:contract:layers]
name = Enforce layered architecture
type = layers
layers =
    routers
    services
    repositories
    domain

[importlinter:contract:domain-isolation]
name = Domain layer must not import from any other internal layer
type = forbidden
source_modules =
    domain
forbidden_modules =
    routers
    services
    repositories
    config
    schemas

[importlinter:contract:routers-no-domain]
name = Routers must not access domain layer directly
type = forbidden
source_modules =
    routers
forbidden_modules =
    domain

[importlinter:contract:routers-no-repositories]
name = Routers must not access repositories directly
type = forbidden
source_modules =
    routers
forbidden_modules =
    repositories
allow_indirect_imports = True

[importlinter:contract:repositories-no-upward-deps]
name = Repositories must not depend on higher layers
type = forbidden
source_modules =
    repositories
forbidden_modules =
    routers
    services
    domain
    schemas

[importlinter:contract:services-no-routers]
name = Services must not depend on routers
type = forbidden
source_modules =
    services
forbidden_modules =
    routers

[importlinter:contract:schemas-isolation]
name = Schemas must remain isolated from app layers
type = forbidden
source_modules =
    schemas
forbidden_modules =
    routers
    services
    repositories
    domain
    config
